{
  "manifest_version": 3,
  "name": "Color Inverter",
  "version": "1.1",
  "description": "Inverts webpage colors to convert dark mode sites to light mode while preserving images and SVGs",

  "permissions": ["storage"],

  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],

  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+I" },
      "description": "Toggle color inversion"
    }
  },

  "action": {
    "default_title": "Toggle color inversion (Alt+I)"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
